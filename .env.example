# Copy to server/.env (or export these). Never commit real secrets.
SECRET_KEY=change-me
DATABASE_URL=sqlite:///./infrasight.db
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
AI_MOCK=1

# Feature flags (read on every request)
FLAG_TIER2_ADMIN_ENABLED=1
FLAG_TIER3_COMPLIANCE_ENABLED=0
FLAG_TIER3_UTILITY_ALERTS_ENABLED=1
FLAG_TIER3_SOP_GENERATION_ENABLED=1
FLAG_AI_ASSESSMENT_ENABLED=1

# Enrichment retries
ENRICHMENT_RETRIES=3
ENRICHMENT_BACKOFF_S=0.5
