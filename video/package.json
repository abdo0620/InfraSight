{
  "name": "infrasight-trailer",
  "private": true,
  "description": "Product trailer for InfraSight (Remotion, 1920x1080, 30 fps)",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render Trailer out/infrasight-trailer.mp4 --codec=h264 --crf=18 --props={\"version\":0}",
    "sound": "python audio/make_sfx.py && python audio/make_music.py && bash audio/build_versions.sh",
    "still": "remotion still Trailer",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.536",
    "@remotion/google-fonts": "4.0.536",
    "@remotion/transitions": "4.0.536",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.536"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
