# Muse Spark via the Meta Model API, key from dev.meta.ai
META_API_KEY=
# Model names. Empty = muse-spark-1.1 for meta. Try muse-spark-1.3 if your dev.meta.ai dashboard lists it.
MODEL_QUICK=
MODEL_DEFAULT=
# Image model for the repair preview (photo after repair). Empty = muse-image-1.0, $0.01 per image.
MODEL_IMAGE=
# Signs login tokens and photo links. start.bat fills it in. Or: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Sample tickets on an empty database; with DEMO_PASSWORD also users citizen / tech / elected. Never in production.
SEED_DEMO=true
DEMO_PASSWORD=
# Own SAM 3.1 server (see sam_server/, needs a GPU). Empty: SAM 3.1 runs on the Meta Model API with META_API_KEY.
SAM_URL=
